# GROQ Configuration (Required - Free & Fast!)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace Configuration (Optional but recommended for better rate limits)
HF_TOKEN=your_huggingface_token

# Server Configuration(for local development)
HOST=localhost
PORT=8000

# Server Configuration(for production deployment)
# HOST=0.0.0.0
# PORT=8000

# Pinecone Configuration (Optional for Pinecone vector database)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=your_pinecone_index_name

# Models (optional overrides)
# EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
# CHAT_MODEL=llama3-8b-8192

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
SUPABASE_BUCKET=your_supabase_bucket

# CORS Configuration (for local development)
CORS_ORIGINS=http://localhost:3000

# CORS Configuration (for production deployment)
# CORS_ORIGINS=your_production_frontend_url